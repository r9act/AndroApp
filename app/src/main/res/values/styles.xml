<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Базовая тема приложения -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
    </style>

    <!-- Стиль для черных кнопок -->
    <style name="BlackButton" parent="Widget.AppCompat.Button">
        <item name="android:background">#000000</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="backgroundTint">@null</item> <!-- Отключает заливку от темы -->
    </style>

    <style name="SplashTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item> <!-- Чёрный фон -->
    </style>
</resources>